{
  "name": "js-util-kit",
  "version": "1.0.2",
  "description": "A comprehensive TypeScript utility library providing type-safe, zero-dependency utilities for modern JavaScript/TypeScript applications",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "dev": "tsdown src/index.ts --watch --format esm,cjs --dts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "utilities",
    "typescript",
    "utils",
    "helpers",
    "validation",
    "logger",
    "error-handling",
    "date-utils",
    "string-utils",
    "array-utils",
    "auth",
    "jwt",
    "angular",
    "react",
    "node",
    "browser",
    "ssr",
    "tree-shakeable",
    "zero-dependencies"
  ],
  "engines": {
    "node": ">=15.0.0"
  },
  "author": "",
  "homepage": "https://github.com/pageupsoft-org/js-util-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pageupsoft-org/js-util-kit.git"
  },
  "bugs": {
    "url": "https://github.com/pageupsoft-org/js-util-kit/issues"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
